# Copy to .env and fill in real values. .env is gitignored; this file is committed.

# --- Database (Postgres in Docker, used by docker-compose.yml) ---
POSTGRES_USER=ap_agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=erp
POSTGRES_PORT=5432
# Connection string for Python code; keep it in sync with the values above
DATABASE_URL=postgresql://ap_agent:change-me@localhost:5432/erp

# --- LLM provider ---
ANTHROPIC_API_KEY=

# --- Langfuse tracing (cloud free tier for now) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
